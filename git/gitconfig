[include]
  # NOTE: MUST exist for [user] name/email
  # and optional stuff like signingKey / gpgSign
  path = ~/.gitconfig-local

[core]
  editor = vim
  excludesfile = ~/.gitignore

[init]
  defaultBranch = main

[pull]
  ff = only

[credential]
  helper = store

[alias]

  git = !exec git
  g = !exec git

  a = add
  b = branch
  c = commit
  d = diff
  h = rev-parse HEAD
  m = merge
  p = push
  s = status
  t = tag

  ap = add -p
  # NOTE: git split "checkout" into "switch" (branches) and "restore" (files)
  c- = switch -
  co = switch
  d1 = diff HEAD~1
  dc = diff --cached
  dh = diff origin/HEAD HEAD
  fa = fetch --all
  # _f_iles _c_hanged in this branch (will include changed-then-unchanged)
  fc = !git log --oneline --name-only origin/HEAD..HEAD | ag -v ' ' | sort -u
  ll = log --pretty=format:'%C(yellow)%h%Cred%d %Creset%s%Cgreen (%an)' --decorate --numstat
  lg = log --pretty=format:'%C(yellow)%h %Cred%d %Creset%s (%Cgreen%an)' --graph
  lh = log --oneline origin..HEAD
  ls = log --pretty=format:'%C(yellow)%h%Cred%d %Creset%s%Cgreen [%an]' --decorate
  mm = merge origin/HEAD
  m- = merge -
  mc = merge --continue
  pl = pull
  pt = push --tags
  pu = !git push -u origin $(git rev-parse --abbrev-ref HEAD)
  rc = rebase --continue
  ri = rebase -i
  sm = !git submodule sync && git submodule update
  tl = !git tag --sort=-v:refname -l | head -1

  com = !git switch $(git symbolic-ref --short refs/remotes/origin/HEAD | sed 's@^origin/@@') && git fetch --all --prune
  rom = !git rebase origin/HEAD

  ## GH CLI
  pr = !gh pr create --title "$(git rev-parse --abbrev-ref HEAD)" --body-file .github/pull_request_template.md

  # HUB CLI
  ci = "!hub ci-status"
  ci-status = "!hub ci-status -v"
  ci-fail = "!hub ci-status -v | grep ✖ | cut -d' ' -f2"

[color]
  ui=auto
  status = auto
  branch = auto
  interactive = auto
  diff = auto
  mergeoptions = --no-edit

[color "branch"]
  current = cyan
  local = yellow
  remote = green

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

[color "grep"]
  linenumber = cyan
  filename = green

[grep]
  lineNumber = True
  patternType = perl

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
